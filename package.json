{
  "name": "dsh-onenote",
  "version": "0.5.3",
  "description": "OneNote desktop tools for DSH: list/read/search/create/update/append/publish/delete pages through the local OneNote COM automation interface.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "onenote",
    "com",
    "notes",
    "markdown"
  ],
  "license": "UNLICENSED",
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=18.17"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
